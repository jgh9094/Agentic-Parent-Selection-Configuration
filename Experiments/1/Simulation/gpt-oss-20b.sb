#!/bin/bash
########## Define Resources Needed with SBATCH Lines ##########
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --array=1-100
#SBATCH --cpus-per-task=1
#SBATCH -t 48:00:00
#SBATCH --mem=1GB
#SBATCH --job-name=oss-20b
#SBATCH -p defq
#SBATCH --exclude=esplhpc-cp040
###############################################################

# load conda environment
source ~/anaconda3/etc/profile.d/conda.sh
conda activate agentic-gp

# Define the selector and output directory (they are the same here)
ALL_DIR=~/Repos/agentic-gp/Algorithm_Output/Exp1/gpt-oss-20b/Rep_${SLURM_ARRAY_TASK_ID}
SELECTOR_DIR=${ALL_DIR}/selector.py

# Seed param
SEED=$((SLURM_ARRAY_TASK_ID))

# let it rip
python ~/Repos/agentic-gp/gp_simulated_selection/simulated_selection.py \
${SELECTOR_DIR} \
--seed ${SEED}