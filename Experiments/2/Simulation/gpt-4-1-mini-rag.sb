#!/bin/bash
########## Define Resources Needed with SBATCH Lines ##########
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --array=1-100
#SBATCH --cpus-per-task=1
#SBATCH -t 01:00:00
#SBATCH --mem=1GB
#SBATCH --job-name=4.1-mini
#SBATCH -p defq,moore
#SBATCH --exclude=esplhpc-cp040
###############################################################

# load conda environment
source ~/anaconda3/etc/profile.d/conda.sh
conda activate agp-ps

# Define the selector and output directory (they are the same here)
ALL_DIR=~/Repos/Agentic-Parent-Selection-Configuration/Algorithm_Output/Exp2/RAG/gpt-4-1-mini/Rep_${SLURM_ARRAY_TASK_ID}
SELECTOR_DIR=${ALL_DIR}/selector.py

# Seed param
SEED=$((SLURM_ARRAY_TASK_ID))

# let it rip
python ~/Repos/Agentic-Parent-Selection-Configuration/GP/Source/simulated_selection.py \
${SELECTOR_DIR} \
--seed ${SEED}