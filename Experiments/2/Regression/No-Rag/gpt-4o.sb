#!/bin/bash
########## Define Resources Needed with SBATCH Lines ##########
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --array=1-100
#SBATCH --cpus-per-task=8
#SBATCH -t 10:00:00
#SBATCH --mem=1GB
#SBATCH --job-name=4o
#SBATCH -p defq,moore
#SBATCH --exclude=esplhpc-cp040
###############################################################

# load conda environment
source ~/anaconda3/etc/profile.d/conda.sh
conda activate agp-ps

# Define the selector and output directory (they are the same here)
MAIN_DIR=~/Repos/Agentic-Parent-Selection-Configuration/
DATA_DIR=${MAIN_DIR}Data-GP/Exp2/
REP_DIR=${DATA_DIR}Rep_${SLURM_ARRAY_TASK_ID}/
SELECTOR_DIR=${MAIN_DIR}Algorithm_Output/Exp2/No-RAG/gpt-4o/Rep_${SLURM_ARRAY_TASK_ID}/selector.py
RESULTS_DIR=${MAIN_DIR}Regression_Results/Exp2/No-RAG/gpt-4o/Rep_${SLURM_ARRAY_TASK_ID}/

# make results directory
mkdir -p ${RESULTS_DIR}

# Seed param
SEED=$((SLURM_ARRAY_TASK_ID))

# let it rip
python ~/Repos/Agentic-Parent-Selection-Configuration/GP/Source/gp.py \
--data_dir ${DATA_DIR} \
--split_dir ${REP_DIR} \
--selector_path ${SELECTOR_DIR} \
--seed ${SEED} \
--output_dir ${RESULTS_DIR} \
--n_cpus 8